{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AION Timetable Overlay",
  "version": "0.1.0",
  "identifier": "tv.skeeve.aiontimetable",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AION Timetable Overlay",
        "width": 420,
        "height": 640,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/REPLACE_ME_GITHUB_USER/timetable/releases/latest/download/latest.json"
      ],
      "pubkey": "REPLACE_ME_RUN_pnpm_tauri_signer_generate"
    }
  }
}
